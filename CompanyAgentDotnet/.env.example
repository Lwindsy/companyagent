# LLM provider: anthropic (default) or deepseek. SPRING_PROFILES_ACTIVE is also honoured.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Leave unset to use https://api.anthropic.com (an empty value is treated as unset).
# ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | max (applies to models that support effort)
ANTHROPIC_EFFORT=low
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_FALLBACK_ENABLED=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to false to keep working memory in-process (local runs without Redis).
REDIS_ENABLED=true

# Administrator sign-in is disabled until a password is set.
# Use the same values as the Python and Java backends so one sign-in covers all three.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SERVER_PORT=8090
COMPANYAGENT_DATA_DIR=data/dotnet
COMPANYAGENT_SKILLS_DIR=skills
EVAL_BASELINE_PATH=data/eval/baseline.json
ALERT_WEBHOOK_URL=
