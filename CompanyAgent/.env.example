# CompanyAgent 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=CompanyAgent
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# 管理后台登录（Python / Java / .NET 共用）。没有默认密码，留空则禁止管理员登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 官方 Claude API：写明地址，不要留空（Java 服务会把空值当成地址）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
# 新一代模型的思考深度：low / medium / high / max（默认 low，客服对话够用且省 token）
# ANTHROPIC_EFFORT=low

# 改用 DeepSeek（兼容 Anthropic 协议）时：
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_MODEL=deepseek-v4-pro      # 低成本/高并发场景可用 deepseek-v4-flash

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=companyagent123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
COMPANYAGENT_SKILLS_DIR=./skills
COMPANYAGENT_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
