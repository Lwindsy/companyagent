# The public DNS name that already points to your VM's IPv4 address.
DOMAIN=companyagent.example.com

# Must match CompanyAgent/.env. Use a generated random value, never this placeholder.
REDIS_PASSWORD=replace-with-a-long-random-password

# ── Images ──
# IMAGE_REGISTRY / IMAGE_TAG are written here by the deploy job (and by rollback) after every
# release, so a manual `up --no-build` on the server runs the current release. Do not edit by hand.

# ── Observability (optional: `docker compose --profile observability ... up -d`) ──
# COMPOSE_PROFILES=observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# GRAFANA_ADMIN_PASSWORD=replace-me
